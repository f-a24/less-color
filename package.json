{
  "name": "less-color",
  "version": "1.0.0",
  "type": "module",
  "description": "Less の色関数（mix / tint / spin / lighten / fade / multiply など）の TypeScript 移植",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "license": "MIT",
  "scripts": {
    "build": "bun run build:js && bun run build:types",
    "build:js": "bun build src/index.ts --outdir dist --target browser --format esm",
    "build:types": "tsc -p tsconfig.build.json",
    "prebuild": "rm -rf dist",
    "prepublishOnly": "bun run build",
    "lint": "oxlint",
    "fix": "oxlint --fix",
    "format": "bun fmt --no-script",
    "format:check": "bun fmt --no-script --check",
    "typecheck": "tsc",
    "test": "bun test",
    "build:site": "rm -rf site-dist && bun build site/index.html --outdir site-dist --minify",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.ts": [
      "oxlint --fix",
      "bun fmt --no-script"
    ]
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/less": "^3.0.8",
    "husky": "^9.1.7",
    "less": "^4.9.1",
    "lint-staged": "^17.6.0",
    "oxlint": "^1.90.0",
    "typescript": "^7.0.2"
  }
}
