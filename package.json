{
  "name": "less-functions",
  "version": "1.0.0",
  "type": "module",
  "main": "src/index.ts",
  "license": "MIT",
  "scripts": {
    "lint": "oxlint",
    "fix": "oxlint --fix",
    "format": "bun fmt --no-script",
    "format:check": "bun fmt --no-script --check",
    "typecheck": "tsc",
    "test": "bun test",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.ts": [
      "oxlint --fix",
      "bun fmt --no-script"
    ]
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxlint": "^1.90.0",
    "typescript": "^7.0.2"
  }
}
